rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chỉ GVCN đã xác thực mới được truy cập dữ liệu
    match /teachers/{teacherId} {
      allow read, write: if request.auth != null && request.auth.uid == teacherId;
    }

    match /classes/{classId} {
      allow read, write: if request.auth != null;
      
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    match /students/{studentId} {
      allow read, write: if request.auth != null;
    }

    match /academic_scores/{scoreId} {
      allow read, write: if request.auth != null;
    }

    match /conduct_records/{recordId} {
      allow read, write: if request.auth != null;
    }

    match /weekly_point_transactions/{transactionId} {
      allow read, write: if request.auth != null;
    }

    match /point_rules/{ruleId} {
      allow read, write: if request.auth != null;
    }

    match /attendance_records/{attendanceId} {
      allow read, write: if request.auth != null;
    }

    match /learning_records/{recordId} {
      allow read, write: if request.auth != null;
    }

    match /class_settings/{settingId} {
      allow read, write: if request.auth != null;
    }

    match /backups/{backupId} {
      allow read, write: if request.auth != null;
    }

    match /classification_configs/{configId} {
      allow read, write: if request.auth != null;
    }

    match /official_classifications/{classificationId} {
      allow read, write: if request.auth != null;
    }

    match /timetable/{itemId} {
      allow read, write: if request.auth != null;
    }
  }
}
